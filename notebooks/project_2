    "import pandas as pd\n",
    "\n",
    "#Load data file\n",
    "df = pd.read_csv('laureates.csv')\n",
    "\n",
    "\n",
    "\n",
    "#Inspect Information\n",
    "df.head()\n",
    "df.info()\n",
    "df.isna().sum()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "04e8be4e-4e91-4cac-a033-aa8b7498365b",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Map camelCase names to clean snake_case\n",
    "df = df.rename(columns={\n",
    "    'born':              'birth_date',\n",
    "    'died':              'death_date',\n",
    "    'bornCountry':       'born_country',\n",
    "    'bornCountryCode':   'born_country_code',\n",
    "    'bornCity':          'born_city',\n",
    "    'diedCountry':       'died_country',\n",
    "    'diedCountryCode':   'died_country_code',\n",
    "    'diedCity':          'died_city',\n",
    "    'year':              'award_year',\n",
    "    'overallMotivation': 'overall_motivation'\n",
    "})\n",
    "\n",
    "#As a final pass, lowercase everything just in case\n",
    "df.columns = df.columns.str.lower()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "7c981494-029c-426a-9986-dcf57953bcdd",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Turn the birth_date and death_date columns into real datetime objects\n",
    "df['birth_date'] = pd.to_datetime(df['birth_date'], errors='coerce')\n",
    "df['death_date'] = pd.to_datetime(df['death_date'], errors='coerce')\n",
    "\n",
    "#Ensure award_year is an integer bad parses → <NA>\n",
    "df['award_year'] = pd.to_numeric(df['award_year'], errors='coerce').astype('Int64')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "a370917a-78ec-415a-8fee-19ac66a11e94",
   "metadata": {},
   "outputs": [],
   "source": [
    "#For Q1 (keywords) and Q3 (age) we need both a motivation text and a birth_date\n",
    "df = df.dropna(subset=['motivation', 'birth_date'])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "baf6c976-e8d5-4065-8701-1a1589e33861",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Extract the birth year from the full date\n",
    "df['birth_year'] = df['birth_date'].dt.year\n",
    "\n",
    "#Compute age at the time of award\n",
    "df['age_at_award'] = df['award_year'] - df['birth_year']\n",
    "\n",
    "#Group awards by decade (e.g., 1994 → 1990s)\n",
    "df['decade'] = (df['award_year'] // 10) * 10\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 62,
   "id": "fd16a692-2002-482f-88da-9bde8ed3c215",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Title-case and trim whitespace in 'category'\n",
    "df['category'] = df['category'].str.title().str.strip()\n",
    "\n",
    "# Capitalize 'gender' and fill missing values with 'Unknown'\n",
    "df['gender']   = df['gender'].str.capitalize().fillna('Unknown')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "9b3e8ac0-a152-48f7-a7e2-8983d9c5ad8c",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Lowercase, strip punctuation, trim whitespace\n",
    "df['motivation_clean'] = (\n",
    "    df['motivation']\n",
    "      .str.lower()\n",
    "      .str.replace(r'[\\W_]+', ' ', regex=True)\n",
    "      .str.strip()\n",
    ")\n"
   ]
